# Copy to `.env` to override the built-in defaults. Everything below is
# optional: with no `.env` at all, the server uses data/leetcode.db and a
# stable built-in user id, so a fresh clone works out of the box.

# Local database -----------------------------------------------------------
# SQLite file path, relative to the repo root. Parent dirs are created on
# first use. Use ":memory:" for a throwaway in-memory database.
LEETCOACH_DB_PATH=data/leetcode.db

# Single-user mode: the user id attached to every row when a tool call does
# not pass an explicit user_id. Keep it stable so streaks/progress accumulate
# for the same local user.
LEETCOACH_DEFAULT_USER_ID=00000000-0000-4000-a000-000000000001

# Transport (optional) -----------------------------------------------------
# stdio (default) for desktop clients. Set to "http" to serve Streamable HTTP
# at http://HOST:PORT/mcp, which is what web LLMs need via a tunnel (ngrok).
LEETCOACH_TRANSPORT=stdio
LEETCOACH_HOST=127.0.0.1
LEETCOACH_PORT=8000

# Scraper tuning (optional) -----------------------------------------------
LEETCODE_GRAPHQL_URL=https://leetcode.com/graphql
LEETCOACH_SCRAPE_PAGE_SIZE=50
LEETCOACH_SCRAPE_DELAY_SECONDS=1.5
LEETCOACH_SCRAPE_MAX_RETRIES=4
LEETCOACH_SCRAPE_BACKOFF_BASE=2.0
